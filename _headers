# Cloudflare Pages response headers
# https://developers.cloudflare.com/pages/platform/headers/
# Note: headers from every matching path are MERGED, so Cache-Control is
# set per category (never in the catch-all) to avoid conflicting directives.

# Security defaults for every response
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# HTML entry points and the service worker: always revalidate,
# so a version bump (PATCH + ?v=) goes live on the next refresh
/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/preferences.html
  Cache-Control: no-cache, must-revalidate

/pages/*
  Cache-Control: no-cache, must-revalidate

/sw.js
  Cache-Control: no-cache, must-revalidate

# Runtime data must never be served stale
/homepage_config.json
  Cache-Control: no-cache, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate

# Assets referenced with ?v=APP_VERSION can be cached for a week
/css/*
  Cache-Control: public, max-age=604800, must-revalidate

/js/*
  Cache-Control: public, max-age=604800, must-revalidate

/locales/*
  Cache-Control: public, max-age=604800, must-revalidate

/templates/*
  Cache-Control: public, max-age=604800, must-revalidate

# Self-hosted bookmark icons: filenames contain a content hash, so they can be
# cached forever — the URL changes whenever the bytes change.
/icons/*
  Cache-Control: public, max-age=31536000, immutable
